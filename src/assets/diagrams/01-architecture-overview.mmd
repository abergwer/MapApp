%% High-level component tree: how the React tree, providers, map engine,
%% and deck.gl overlay relate to each other.
flowchart TB
    main["main.tsx"]
    Theme["ThemeProvider (MUI)"]
    SP["StoreProvider<br/>(RootStore singleton)"]
    App["App.tsx<br/>(observer)"]

    main --> Theme --> SP --> App

    App --> MW["MapWrapper<br/>(observer)"]
    App --> LM["LayerManager<br/>(observer)"]

    subgraph MapOverlays["MapWrapper overlays"]
        direction LR
        TB["ToolBar"]
        MT["MeasuringTools"]
        MSB["MapStyleBar"]
        CB["CoordinatesBar"]
        MM["MiniMap"]
        MV["MiniVideo"]
    end

    MW --> EC["Engine container &lt;div&gt;"]
    MW --> MapOverlays

    EC -. mounts .-> Engine{{"MapEngine<br/>Leaflet | MapLibre | Cesium"}}

    LM --> Deck["Deck.gl canvas<br/>(z-index above basemap)"]
    Deck --> Layers["AirCraft · Drone · Missile<br/>Polygon · RangeRings"]

    MV -. WebRTC .-> Signal[("Signaling server<br/>config.VideoSignalingURL")]
